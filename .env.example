# Profile Scraping MCP Server Configuration

# Server Configuration
SERVER_NAME=profile-scraping-mcp
DEBUG=false
LOG_LEVEL=INFO

# Database Configuration
DATABASE_PATH=./data/profile_scraping.db
CACHE_TTL=3600
ENABLE_CACHING=true

# Rate Limiting Configuration
LINKEDIN_RATE_LIMIT=30
APOLLO_RATE_LIMIT=100
NUBELA_RATE_LIMIT=50
AI_RATE_LIMIT=60

# API Keys
APOLLO_API_KEY=your_apollo_api_key_here
NUBELA_API_KEY=your_nubela_api_key_here

# AI Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# LinkedIn Configuration (Optional)
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password

# Proxy Configuration (Optional)
HTTP_PROXY=
HTTPS_PROXY=
PROXY_USERNAME=
PROXY_PASSWORD=

# Advanced Configuration
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=30
RETRY_ATTEMPTS=3
RETRY_DELAY=1

# Feature Flags
ENABLE_AI_VALIDATION=true
ENABLE_CONTACT_ENRICHMENT=true
ENABLE_COMPANY_ENRICHMENT=true
ENABLE_ACTIVITY_TRACKING=false